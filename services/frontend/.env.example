# Public URL of the Next.js site
NEXT_PUBLIC_SITE_URL=https://indexecoresort.com

# mock = Phase 0 fixtures in src/fixtures/ · api = Laravel JSON API (architecture §5.3)
DATA_SOURCE=mock

# Laravel read-only API base (only used when DATA_SOURCE=api)
CMS_API_URL=https://cms.indexecoresort.com/api/v1

# Where unknown paths are proxied (admin, /public/storage/*, PDFs, legacy URLs).
# Today the CMS is still on the apex domain; switch to https://cms.indexecoresort.com at cut-over.
LARAVEL_ORIGIN=https://indexecoresort.com

# Shared secret for POST /api/revalidate?secret=…&tag=…
REVALIDATE_SECRET=change-me
