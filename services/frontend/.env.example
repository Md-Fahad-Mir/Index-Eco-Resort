# Public URL of the site. Used for canonical URLs, sitemap and JSON-LD, and it
# decides whether the CSP sends `upgrade-insecure-requests` (https only).
# For a local build/test over plain http, set http://localhost:3000 in .env.local.
NEXT_PUBLIC_SITE_URL=https://indexecoresort.com

# mock = the Phase 0 content snapshot in src/fixtures (default)
# api  = a Django backend implementing docs/API-CONTRACT.md
DATA_SOURCE=mock

# Django REST base, e.g. https://api.indexecoresort.com/v1. Unused while DATA_SOURCE=mock.
API_BASE_URL=

# Empty = serve the mirrored media from public/media on this origin.
# Later: the origin Django serves its media from.
MEDIA_BASE_URL=

# A production build on fixtures is refused unless this is true, so snapshot
# content can never ship as if it were live. Preview builds show a banner.
PREVIEW_MODE=false

# Opt-in legacy proxy. Unset by default — the frontend is self-contained.
# Set only for a transitional deployment that still needs the old site's
# /admin, /public/storage/* and legacy URLs to answer.
LEGACY_ORIGIN=

# Shared secret for POST /api/revalidate?secret=…&tag=…
REVALIDATE_SECRET=change-me
