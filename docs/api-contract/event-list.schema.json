{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "excerpt": {
        "type": "string"
      },
      "image": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "alt": {
                "default": "",
                "type": "string"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "src",
              "alt"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "day": {
        "type": "string"
      },
      "monthYear": {
        "type": "string"
      },
      "category": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "href": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "href"
        ],
        "additionalProperties": false
      },
      "meta": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "href": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "cta": {
        "type": "object",
        "properties": {
          "label": {
            "default": "",
            "type": "string"
          },
          "href": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "title",
      "excerpt",
      "image",
      "day",
      "monthYear",
      "category",
      "meta",
      "href",
      "slug",
      "cta"
    ],
    "additionalProperties": false
  }
}
