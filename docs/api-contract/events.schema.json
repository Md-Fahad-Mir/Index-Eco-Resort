{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hero": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "breadcrumb": {
          "type": "object",
          "properties": {
            "home": {
              "type": "object",
              "properties": {
                "label": {
                  "default": "",
                  "type": "string"
                },
                "href": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "label",
                "href"
              ],
              "additionalProperties": false
            },
            "current": {
              "type": "string"
            }
          },
          "required": [
            "home",
            "current"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "image",
        "breadcrumb"
      ],
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dateFormat": {
          "type": "string"
        },
        "emptyState": {
          "type": "string"
        },
        "ajaxDetailHrefPattern": {
          "type": "string"
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              },
              "ariaLabel": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "placeholder",
              "ariaLabel"
            ],
            "additionalProperties": false
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mechanism",
        "endpoint",
        "params",
        "dateFormat",
        "emptyState",
        "ajaxDetailHrefPattern",
        "controls",
        "categories"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "image": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string"
                  },
                  "alt": {
                    "default": "",
                    "type": "string"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "required": [
                  "src",
                  "alt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "day": {
            "type": "string"
          },
          "monthYear": {
            "type": "string"
          },
          "category": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "href": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "href"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "href": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "cta": {
            "type": "object",
            "properties": {
              "label": {
                "default": "",
                "type": "string"
              },
              "href": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "excerpt",
          "image",
          "day",
          "monthYear",
          "category",
          "meta",
          "href",
          "slug",
          "cta"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "hero",
    "filters",
    "events"
  ],
  "additionalProperties": false
}
