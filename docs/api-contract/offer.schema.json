{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hero": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "breadcrumb": {
          "type": "object",
          "properties": {
            "home": {
              "type": "object",
              "properties": {
                "label": {
                  "default": "",
                  "type": "string"
                },
                "href": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "label",
                "href"
              ],
              "additionalProperties": false
            },
            "current": {
              "type": "string"
            }
          },
          "required": [
            "home",
            "current"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "image",
        "breadcrumb"
      ],
      "additionalProperties": false
    },
    "headline": {
      "type": "string"
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "poster": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "hero",
    "headline",
    "paragraphs",
    "note",
    "poster"
  ],
  "additionalProperties": false
}
