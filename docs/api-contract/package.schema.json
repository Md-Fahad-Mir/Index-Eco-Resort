{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "href": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "card": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hero": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "breadcrumb": {
          "type": "object",
          "properties": {
            "home": {
              "type": "object",
              "properties": {
                "label": {
                  "default": "",
                  "type": "string"
                },
                "href": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "label",
                "href"
              ],
              "additionalProperties": false
            },
            "current": {
              "type": "string"
            }
          },
          "required": [
            "home",
            "current"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "image",
        "breadcrumb"
      ],
      "additionalProperties": false
    },
    "heading": {
      "type": "string"
    },
    "discountText": {
      "type": "string"
    },
    "cta": {
      "type": "object",
      "properties": {
        "label": {
          "default": "",
          "type": "string"
        },
        "href": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "benefitsTitle": {
      "type": "string"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "youtubeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "youtubeSrc": {
      "type": [
        "string",
        "null"
      ]
    },
    "plans": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "card": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "src": {
                        "type": "string"
                      },
                      "alt": {
                        "default": "",
                        "type": "string"
                      },
                      "width": {
                        "type": "number"
                      },
                      "height": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "src",
                      "alt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "href",
              "slug",
              "card"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "eyebrow",
        "title",
        "packages"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "href",
    "slug",
    "card",
    "hero",
    "heading",
    "discountText",
    "cta",
    "benefitsTitle",
    "benefits",
    "youtubeId",
    "youtubeSrc",
    "plans"
  ],
  "additionalProperties": false
}
