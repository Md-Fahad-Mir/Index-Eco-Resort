{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hero": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "default": "",
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "breadcrumb": {
          "type": "object",
          "properties": {
            "home": {
              "type": "object",
              "properties": {
                "label": {
                  "default": "",
                  "type": "string"
                },
                "href": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "label",
                "href"
              ],
              "additionalProperties": false
            },
            "current": {
              "type": "string"
            }
          },
          "required": [
            "home",
            "current"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "image",
        "breadcrumb"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string"
    },
    "download": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "download": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "href",
        "download"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "hero",
    "text",
    "download"
  ],
  "additionalProperties": false
}
